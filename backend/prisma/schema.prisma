// Prisma Schema for Bank ATM Systemi
// Starting simple with Customers table only
// All table names are lowercase as per Azure configuration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Customer model - Basic information
model Customer {
  id        Int      @id @default(autoincrement())
  firstName String   @map("first_name") @db.VarChar(100)
  lastName  String   @map("last_name") @db.VarChar(100)
  address   String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts  Account[]
  cards     Card[]
  
  
  @@map("customers")
}

// Accounts model
// Supports dual card mode: DEBIT (balance >= 0) and CREDIT (balance >= -creditLimit)
model Account {
  id          Int      @id @default(autoincrement())
  customerId  Int      @map("customer_id")
  accountNumber String   @unique @map("account_number") @db.VarChar(20)
  balance     Decimal    @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  creditLimit  Decimal    @map("credit_limit") @db.Decimal(10, 2) @default(0.00)
  // Soft delete flag: false = account closed/suspended, transactions blocked
  // Used for closing accounts without losing transaction history (regulatory requirement)
  isActive    Boolean  @map("is_active") @default(true)

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cards       Card[]
  transactions Transaction[]
  
  @@index([customerId])
  @@map("accounts")
}

// Card model
// Each card belongs to one account and can operate in DEBIT or CREDIT mode
model Card {
  id          Int      @id @default(autoincrement())
  cardNumber  String   @unique @map("card_number") @db.VarChar(16)
  pinHash     String   @map("pin_hash") @db.VarChar(255)
  customerId   Int      @map("customer_id")
  accountId   Int      @map("account_id")
  expiryDate  DateTime @map("expiry_date")
  isLocked    Boolean  @map("is_locked") @default(false) // Temporary lock (wrong PIN attempts, fraud alert)
  // Soft delete flag: false = card permanently deactivated (lost/stolen/expired)
  // Checked in transactionService before allowing transactions
  isActive    Boolean  @map("is_active") @default(true)
  failedPinAttempts Int @default(0) @map("failed_pin_attempts") // Count of consecutive failed PIN attempts
  lastFailedAttempt DateTime? @map("last_failed_attempt") // Timestamp of last failed PIN attempt
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  
  @@index([customerId])
  @@index([accountId])
  @@map("cards")
}

// Transactions model
// Immutable audit log of all account activity
// cardMode tracks whether transaction used DEBIT or CREDIT mode for compliance
model Transaction {
  id          Int      @id @default(autoincrement())
  accountId   Int     @map("account_id")
  cardId      Int     @map("card_id")
  transactionType TransactionType @map("transaction_type")
  cardMode    CardMode  @map("card_mode") // Records DEBIT/CREDIT mode used at transaction time
  amount      Decimal    @db.Decimal(10, 2)
  balanceAfter Decimal    @map("balance_after") @db.Decimal(10, 2)
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")

  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  
  @@index([accountId])
  @@index([cardId])
  @@map("transactions")
}

// Transaction types
enum TransactionType {
  DEPOSIT       // Money added to account (ATM deposit, bank transfer in)
  WITHDRAWAL    // Money removed from account (ATM withdrawal)
  TRANSFER_IN   // Money received from another account
  TRANSFER_OUT  // Money sent to another account
}

// Card mode - determines balance validation rules
enum CardMode {
  DEBIT   // Balance cannot go negative (balance >= 0)
  CREDIT  // Balance can go negative up to creditLimit (balance >= -creditLimit)
}
